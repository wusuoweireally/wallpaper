{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/@nestjs/cli/bin/nest.js build",
    "dev": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/nodemon/bin/nodemon.js --watch src --ext ts --delay 800 --exec \"node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/typescript/lib/tsc.js -p tsconfig.build.json && node dist/main.js\"",
    "start:prod": "node dist/main",
    "test": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/jest/bin/jest.js",
    "lint": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "typeorm:generate": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts migration:generate",
    "typeorm:run": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts migration:run",
    "typeorm:revert": "node -r ../scripts/ts6-resolve-hook.cjs ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "mysql2": "^3.14.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.3",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript/typescript6": "6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "ms": "^2.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "typescript6-runtime": "npm:typescript@6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
