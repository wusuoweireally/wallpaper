# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=12345678
DB_DATABASE=wallpaper_site

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_please_change_this12321312831821asda
JWT_EXPIRES_IN=180d
# HTTP 访问时需要显式关闭 secure Cookie，HTTPS 部署改为 true
# 开发环境: COOKIE_SECURE=false, COOKIE_SAMESITE=lax, FRONTEND_URL=http://localhost:1234
# 生产环境: COOKIE_SECURE=true, COOKIE_SAMESITE=none, FRONTEND_URL=https://rain-gem.top
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 管理员初始化（仅当数据库无管理员时创建）
ADMIN_USER_ID=1817419920
ADMIN_USER_PASSWORD=tzt..520tzt
ADMIN_USER_EMAIL=a1817419920@qq.com

# 演示数据初始化（仅当数据库无壁纸时创建）
ENABLE_DEMO_SEED=true
DEMO_SEED_LIMIT=8

# 服务端口
PORT=3000

# GitHub OAuth 配置
# 获取方式: https://github.com/settings/developers -> New OAuth App
# ⚠️ 请将下面的占位符替换为你在 GitHub OAuth App 中获得的真实凭证
GITHUB_CLIENT_ID=Ov23liyx3DL1QbF4iwpN
GITHUB_CLIENT_SECRET=c64e32ab6df2034a408bcbb6bfa387deed72149a
# GitHub OAuth 回调地址 - 必须是后端地址
GITHUB_CALLBACK_URL=https://rain-gem.top/api/auth/github/callback
# 前端应用地址 - 用于认证成功/失败后的重定向
FRONTEND_URL=http://localhost:1234
