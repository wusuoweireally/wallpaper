NODE_ENV=development
PORT=3000

# ---------- MySQL（推荐：Docker 只跑库，前后端本机）----------
# compose 将容器 3306 映射到宿主机 127.0.0.1:DB_HOST_PORT（默认 3306）
# 本机 Nest 连库用下面 DB_*；compose 起 mysql 时还需要 MYSQL_ROOT_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_HOST_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wallpaper_site
MYSQL_ROOT_PASSWORD=

TYPEORM_MIGRATIONS_RUN=true

# 至少 16 位，勿提交真实生产密钥
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:1234

ENABLE_DEMO_SEED=false
DEMO_SEED_LIMIT=0

# GitHub OAuth 可选；不使用时留空。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:1234/api/auth/github/callback
