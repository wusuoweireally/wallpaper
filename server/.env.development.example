# 复制为 server/.env.development；本地：pnpm db:up && pnpm dev
NODE_ENV=development
PORT=3000

# Docker MySQL（pnpm db:up）→ 127.0.0.1:DB_HOST_PORT
DB_HOST=127.0.0.1
DB_PORT=3306
DB_HOST_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wallpaper_site
MYSQL_ROOT_PASSWORD=

TYPEORM_MIGRATIONS_RUN=true
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 多子域共享登录态时填写；留空=仅当前域
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:1234

ENABLE_DEMO_SEED=false
# 空库时写入 fixture（开发环境已上传的 COS 直链）；0 或留空 = 全量
DEMO_SEED_LIMIT=0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:1234/api/auth/github/callback

# 腾讯云 COS（上传/审核；桶私有写公开读，审核通过即公开）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE=https://your-bucket-1234567890.cos.ap-guangzhou.myqcloud.com
# 内容审核自定义策略 BizType（数据万象-审核策略里拿）；留空则用桶默认策略
COS_AUDIT_BIZ_TYPE=
