# ============================================
# 生产环境配置模板 (Docker 部署)
# 复制此文件为 .env.production 并填入真实值
# ============================================
NODE_ENV=production

# 数据库 - Docker 容器内连接，服务名=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here
DB_DATABASE=wallpaper_site

# JWT - 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Cookie - 生产环境 HTTPS
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# 服务端口
PORT=3000

# 管理员初始化
ADMIN_USER_ID=10000001
ADMIN_USER_PASSWORD=your_admin_password
ADMIN_USER_EMAIL=admin@your-domain.com

# 演示数据 - 生产环境关闭
ENABLE_DEMO_SEED=false
DEMO_SEED_LIMIT=0

# GitHub OAuth
# 获取方式: https://github.com/settings/developers -> New OAuth App
# Callback URL: https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback
FRONTEND_URL=https://your-domain.com
