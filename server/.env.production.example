# ============================================
# 生产环境配置模板 (Docker 部署)
# 复制此文件为 .env.production 并填入真实值
# ============================================
NODE_ENV=production

# Compose 传给 server 容器的环境文件路径
APP_ENV_FILE=server/.env.production

# 数据库 - server 容器内连接服务名=mysql（容器内始终 3306）
# 宿主机映射端口默认 3306，可用 DB_HOST_PORT 覆盖（与本地占用冲突时改）
DB_HOST=mysql
DB_PORT=3306
DB_HOST_PORT=3306
DB_USERNAME=wallpaper
DB_PASSWORD=
DB_DATABASE=wallpaper_site
MYSQL_ROOT_PASSWORD=

# JWT - 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Cookie - 生产环境 HTTPS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# 服务端口
PORT=3000

# 管理员初始化
ADMIN_USER_ID=10000001
ADMIN_USER_PASSWORD=
ADMIN_USER_EMAIL=admin@your-domain.com

# 演示数据 - 生产环境关闭
ENABLE_DEMO_SEED=false
DEMO_SEED_LIMIT=0

# GitHub OAuth
# 获取方式: https://github.com/settings/developers -> New OAuth App
# Callback URL: https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback
FRONTEND_URL=https://your-domain.com

# ==================== TypeORM / 数据库迁移（生产环境强制要求） ====================
# 生产环境严禁使用 synchronize: true！
# 所有数据库结构变更必须通过迁移文件完成。
# TYPEORM_SYNCHRONIZE 永远不要设置为 true。
TYPEORM_MIGRATIONS_RUN=true
