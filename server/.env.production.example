# 复制为 server/.env.production 后填写；部署：pnpm deploy
NODE_ENV=production
PORT=3000

# 容器内连库固定用服务名 mysql（compose 会再覆盖 DB_HOST/DB_PORT）
DB_HOST=mysql
DB_PORT=3306
DB_HOST_PORT=3306
DB_USERNAME=wallpaper
DB_PASSWORD=
DB_DATABASE=wallpaper_site
MYSQL_ROOT_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 多子域共享登录态时填写，如 .example.com；留空=仅当前域
COOKIE_DOMAIN=
FRONTEND_URL=https://your-domain.com
# 跨站信任来源白名单（逗号分隔，含协议）；留空=仅信任 FRONTEND_URL。
# 用于 GitHub OAuth 回跳放行与登出接口的 Origin 校验
ALLOWED_FRONTEND_ORIGINS=

# 选填：要么整组不填、要么一起填。只填其中一项会直接启动失败（校验按成对处理）；
# 全不填时应用照常启动，但全站没有超级管理员，可事后补齐并重启容器完成创建。
# ADMIN_USER_ID=10000001
# ADMIN_USER_PASSWORD=
# ADMIN_USER_EMAIL=admin@your-domain.com

ENABLE_DEMO_SEED=false
# 空库时写入 fixture（与开发环境同一 COS 直链）；0 或留空 = 全量，不再重新上传
DEMO_SEED_LIMIT=0

# GitHub OAuth 可选；Callback 须与 App 配置一致
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback

# 前端带哈希的 js/css/字体。两个都留空时，这些文件仍由 Nginx 提供。
# VITE_ASSET_BASE 要带路径和结尾斜杠，例如 https://cdn.example.com/web/
# ASSET_CDN_ORIGIN 只写源，例如 https://cdn.example.com
# 域名二选一：直接用 COS 桶公网域名（需桶 CORS 放行 GET、防盗链含站点域名），
# 或腾讯云 CDN 加速域名（回源到上面的 COS 桶）。对象键前缀与 VITE_ASSET_BASE 的路径一致。
# VITE_ASSET_BASE=
# ASSET_CDN_ORIGIN=

# 腾讯云 COS（上传/审核；桶私有写公开读，审核通过即公开）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE=https://your-bucket-1234567890.cos.ap-guangzhou.myqcloud.com
# 内容审核自定义策略 BizType（数据万象-审核策略里拿）；留空则用桶默认策略
COS_AUDIT_BIZ_TYPE=

# 结构只走迁移；生产勿开 synchronize
TYPEORM_MIGRATIONS_RUN=true
