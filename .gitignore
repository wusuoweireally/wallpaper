# ===================================
# pnpm Workspace 项目 - 统一 .gitignore
# ===================================

# ---------------
# 依赖包
# ---------------
node_modules/
.pnp
.pnp.js
# monorepo 只使用根目录锁文件
web/pnpm-lock.yaml
server/pnpm-lock.yaml

# ---------------
# 构建输出
# ---------------
dist/
dist-ssr/
build/
*.local

# ---------------
# 环境变量文件（含敏感信息，严禁提交！）
# ⚠️ 本仓库为公开仓库，任何 .env 都不得提交
# 仅允许提交 *.example 模板（占位符，无真实密钥）
# ---------------
.env
.env.*
!.env.example
!.env.*.example

# ---------------
# 日志文件
# ---------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---------------
# 上传目录：忽略运行时文件，仅跟踪占位与静态/seed 资源
# 本地开发：壁纸原图/缩略图写在本机 uploads，不进 git
# Docker MySQL 数据在容器卷中，与此无关
# ---------------
server/uploads/**
!server/uploads/**/
!server/uploads/**/.gitkeep
!server/uploads/profile-pictures/defaultAvatar.png
# demo-seed 源图目录（可选 seed，非运行时上传）
!server/uploads/壁纸/
!server/uploads/壁纸/**

# ---------------
# SSL 证书（私钥敏感，不提交）
# ---------------
docker/nginx/ssl/

# ---------------
# Docker Compose .env 副本（敏感）
# ---------------
.env.prod

# ---------------
# 编辑器和 IDE 配置
# ---------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDEs
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# VSCode（保留部分配置文件）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Cursor
.cursor/

# ---------------
# 测试覆盖率
# ---------------
coverage/
*.lcov
.nyc_output/
test-results/
.api-smoke-out/

# ---------------
# 临时文件和缓存
# ---------------
.tmp/
*.tmp
*.temp
.cache/
.parcel-cache/
.fusebox/
.serverless/
.dynamodb/
.tern-port

# ---------------
# TypeScript
# ---------------
*.tsbuildinfo

# ---------------
# 包管理器缓存
# ---------------
.npm/
.eslintcache
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity
.pnp.*

# ---------------
# 运行时数据
# ---------------
pids
*.pid
*.seed
*.pid.lock

# 诊断报告
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------------
# 其他
# ---------------
# 可选的 npm 缓存目录
.npm

# 可选的 REPL 历史
.node_repl_history

# 输出目录
*.tgz

# Yarn
.yarn-integrity

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# 本机 AI 工具配置（可能包含访问令牌）
.claude/settings.json
