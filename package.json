{
  "name": "wallpaper-system",
  "private": true,
  "version": "1.0.0",
  "description": "Wallbay — 壁纸分享社区",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r run test",
    "db:up": "docker compose --env-file server/.env.development up -d mysql",
    "db:down": "docker compose --env-file server/.env.development stop mysql",
    "db:reset": "docker compose --env-file server/.env.development down -v && docker compose --env-file server/.env.development up -d mysql",
    "deploy": "docker compose --env-file server/.env.production --profile app up -d --build",
    "deploy:down": "docker compose --env-file server/.env.production --profile app down",
    "deploy:logs": "docker compose --env-file server/.env.production --profile app logs -f --tail=200",
    "backup": "sh scripts/backup-mysql.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "wallpaper",
    "vue3",
    "nestjs",
    "typescript",
    "wallpaper-system"
  ],
  "author": "",
  "license": "MIT"
}
